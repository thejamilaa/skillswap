# Supabase Sozlamalari (Yangi ochilgan loyihangizdan oling)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Sayt manzili (Mahalliy ishlab chiqish uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Daily.co API Key (Video qo'ng'iroqlar xonasi uchun, ixtiyoriy)
DAILY_API_KEY=your-daily-co-api-key

# Cloudflare R2 Sozlamalari (Rasmlar va media fayllar uchun)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=skillswap-avatars
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev
